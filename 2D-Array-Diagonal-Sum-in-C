#include <stdio.h>
int main(){
  int arr[100][100],a,b;
  printf("please enter the size of couloumn[MAX100]:");
  scanf("%d",&a);
  printf("please enter the size of row[MAX100]:");
  scanf("%d",&b);
  for(int i=0;i<a;i++){
    for(int j=0;j<b;j++){
        printf("Enter the value on position(%d,%d):",i,j);
        scanf("%d",&arr[i][j]);
    }
    printf("\n");
  }
  printf("\n");
  for(int i=0;i<a;i++){
    for(int j=0;j<b;j++){
        printf("%d\t",arr[i][j]);
    }
    printf("\n");
  }
  int sum=0;
  for(int i=0;i<a;i++){
    
        sum=sum+arr[i][i];
    
  }
  printf("Diagonal sum:%d",sum);
}
